# ============================================================
# RaithuSetu Frontend — Environment Variables Template
# Copy this to .env.local for local dev, or set these in your
# deployment platform (Vercel / Netlify / Render) dashboard.
# NEVER commit .env.local to Git.
# ============================================================

# URL of your deployed Django backend (no trailing slash)
# Local dev:
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Production example (replace with your actual backend URL):
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
# VITE_API_BASE_URL=https://api.raithusetu.com/api
