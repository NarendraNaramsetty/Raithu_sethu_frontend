# ============================================================
# RaithuSetu React Frontend — .gitignore
# ============================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# --- Build output ---
dist/
dist-ssr/
build/
out/

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Test coverage ---
coverage/
.nyc_output/
*.lcov

# --- Vite cache ---
.vite/
vite.config.js.timestamp-*

# --- TypeScript / ESLint cache ---
*.tsbuildinfo
.eslintcache
.oxlintrc.json.cache

# --- IDE / Editor ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Storybook ---
storybook-static/

# --- Vercel / Netlify / Render deploy artifacts ---
.vercel/
.netlify/
.output/

# --- Miscellaneous ---
*.tmp
*.bak
*~
